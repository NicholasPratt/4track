+namespace
+{
+    class PlaybackCountInNode final : public Node
+    {
+    public:
+        PlaybackCountInNode (std::unique_ptr<Node> source, TransportControl& tc,
+                             tracktion::graph::PlayHead& ph, double rate)
+            : input (std::move (source)), transport (tc), playHead (ph), sampleRate (rate) {}
+
+        NodeProperties getNodeProperties() override
+        {
+            auto properties = input->getNodeProperties();
+            if (properties.nodeID != 0)
+                tracktion::hash_combine (properties.nodeID, static_cast<size_t> (0x72966cf3));
+            return properties;
+        }
+        std::vector<Node*> getDirectInputNodes() override { return { input.get() }; }
+        bool isReadyToProcess() override { return input->hasProcessed(); }
+
+        void process (ProcessContext& pc) override
+        {
+            const auto source = input->getProcessedOutput();
+            const double end = transport.getPlaybackCountInEndSeconds();
+            int mutedFrames = 0;
+            if (std::isfinite (end))
+            {
+                const auto start = playHead.referenceSamplePositionToTimelinePositionUnlooped (pc.referenceSampleRange.getStart());
+                const auto endSample = tracktion::toSamples (TimePosition::fromSeconds (end), sampleRate);
+                mutedFrames = static_cast<int> (juce::jlimit<int64_t> (0, pc.numSamples, endSample - start));
+            }
+
+            if (mutedFrames == 0)
+            {
+                setAudioOutput (input.get(), source.audio);
+                pc.buffers.midi.copyFrom (source.midi);
+                return;
+            }
+
+            auto audio = pc.buffers.audio;
+            audio.getFrameRange ({ 0, static_cast<choc::buffer::FrameCount> (mutedFrames) }).clear();
+            if (mutedFrames < static_cast<int> (pc.numSamples))
+            {
+                const choc::buffer::FrameRange audible { static_cast<choc::buffer::FrameCount> (mutedFrames), pc.numSamples };
+                copyIfNotAliased (audio.getFrameRange (audible), source.audio.getFrameRange (audible));
+            }
+            for (const auto& message : source.midi)
+                if (message.getTimeStamp() >= mutedFrames / sampleRate)
+                    pc.buffers.midi.add (message);
+            pc.buffers.midi.isAllNotesOff = source.midi.isAllNotesOff;
+        }
+
+    private:
+        std::unique_ptr<Node> input;
+        TransportControl& transport;
+        tracktion::graph::PlayHead& playHead;
+        double sampleRate;
+    };
+}
