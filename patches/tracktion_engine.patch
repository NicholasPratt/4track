+/** Borrows a plugin node owned by the main branch and emits only the aux audio. */
+class PluginAuxOutputNode final : public Node
+{
+public:
+    PluginAuxOutputNode (Node& source, int first, int size)
+        : input (source), firstChannel (first), numChannels (size) {}
+
+    NodeProperties getNodeProperties() override
+    {
+        auto props = input.getNodeProperties();
+        props.hasAudio = true;
+        props.hasMidi = false;
+        props.numberOfChannels = numChannels;
+        hash_combine (props.nodeID, static_cast<size_t> (0x6175786f7574));
+        hash_combine (props.nodeID, firstChannel);
+        return props;
+    }
+
+    std::vector<Node*> getDirectInputNodes() override { return { &input }; }
+    bool isReadyToProcess() override { return input.hasProcessed(); }
+
+    void process (ProcessContext& pc) override
+    {
+        const auto audio = input.getProcessedOutput().audio;
+        if (firstChannel + numChannels <= static_cast<int> (audio.getNumChannels()))
+            copy (pc.buffers.audio, audio.getChannelRange ({ static_cast<choc::buffer::ChannelCount> (firstChannel),
+                                                            static_cast<choc::buffer::ChannelCount> (firstChannel + numChannels) }));
+    }
+
+private:
+    Node& input;
+    const int firstChannel, numChannels;
+};
